{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oass",
  "version": "0.2.0",
  "identifier": "dev.oass.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oass",
        "width": 1240,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
